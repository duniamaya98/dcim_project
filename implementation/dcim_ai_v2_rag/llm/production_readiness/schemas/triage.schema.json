{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcim.local/schemas/triage.schema.json",
  "title": "DCIM Triage Decision (flat, reliable single-shot for Q4 model)",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "risk", "recommended_action",
               "requires_human_approval", "confidence"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["investigating", "needs_more_data", "ready_for_approval",
               "action_executed", "escalated", "resolved"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "recommended_action": { "type": "string", "minLength": 1 },
    "requires_human_approval": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
